# SatRank V3 — environment template.
# Copy to .env and fill in. The only REQUIRED value is DATABASE_URL.

# Server
PORT=3000
SATRANK_API_BASE=http://localhost:3000
LOG_LEVEL=info

# Postgres (REQUIRED)
DATABASE_URL=postgres://satrank:satrank@localhost:5432/satrank

# LND REST (optional — without it, paid probes + the /api/intent paid gate are off)
# LND_REST_URL=https://localhost:8080
# LND_MACAROON_HEX=0201036c6e64...
# LND_TLS_CERT_PATH=/etc/lnd/tls.cert

# Nostr (optional — without it, no kind 30782 trust assertions are published)
# NOSTR_PRIVATE_KEY=<64-char hex>
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://nostr.mom

# L402 native gate (REQUIRED for paid /api/intent — 32-byte hex secret)
# L402_MACAROON_SECRET=<64-char hex>
L402_INTENT_PRICE_SATS=2

# Probe + scoring
PROBE_FETCH_TIMEOUT_MS=15000
PROBE_MAX_INVOICE_SATS=1000
MEANINGFUL_N_OBS_MIN=3

# Crawler
CRAWLER_INTERVAL_SEC=3600
PAID_PROBE_ENABLED=false
PAID_PROBE_DAILY_BUDGET_SATS=2000

REVENUE_LOG_RETENTION_DAYS=90
