{
  "name": "satrank",
  "version": "3.0.0",
  "description": "Lightning trust oracle for AI agents. Bitcoin-pure.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp src/schema.sql dist/schema.sql",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "lint:tests": "tsc --noEmit -p tsconfig.tests.json"
  },
  "keywords": [
