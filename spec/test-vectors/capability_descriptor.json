        "method": "POST",
        "url": "https://example/translate",
        "input_schema": { "type": "object" },
        "output_schema": { "type": "string" },
        "price_msat": 5000,
        "quote_validity_s": 300,
        "evidence_endpoint": "https://example/.well-known/aeps-evidence",
        "bond_pubkey": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "dlc_oracles": [],
        "dlc_threshold": 0,
        "version": "0.1"
      },
      "expected_canonical": "{\"bond_pubkey\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\"dlc_oracles\":[],\"dlc_threshold\":0,\"evidence_endpoint\":\"https://example/.well-known/aeps-evidence\",\"input_schema\":{\"type\":\"object\"},\"method\":\"POST\",\"operator_pubkey\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"output_schema\":{\"type\":\"string\"},\"price_msat\":5000,\"quote_validity_s\":300,\"url\":\"https://example/translate\",\"version\":\"0.1\"}",
      "expected_endpoint_id": "3985ac6bd772fcc72ca57f204cfc8fbae980087b1f3fd9dd9a7980f9cbd942d3"
