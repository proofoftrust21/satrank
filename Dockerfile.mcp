# Phase 12.16 — minimal Dockerfile for the SatRank MCP server.
# Distributable to mcpmarket / smithery / GHCR. Stdio transport ; no exposed
# port. Runs as a non-root user. Reads config exclusively from env.
FROM node:20-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json* ./
RUN npm ci --only=production --no-audit --no-fund && \
    addgroup -S satrank && adduser -S satrank -G satrank
COPY --from=builder /app/dist ./dist
USER satrank
# stdio transport — no EXPOSE / no listening port. The MCP client
# (Claude Code, Cursor, etc.) drives the connection via stdin/stdout.
ENTRYPOINT ["node", "dist/mcp/server.js"]
